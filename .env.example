# Tend runs with none of these set, in a clearly labelled demo mode:
# PayPal is simulated (SIM- ids) and bills are read without AI.
# Each key you add switches that part to the real thing. See /setup in the app.

# --- PayPal (sandbox) ---------------------------------------------------
# developer.paypal.com → Apps & Credentials → Sandbox → your app
# Tick Payouts, Invoicing and Vault under the app's features.
# The PayPal buttons use JS SDK v6 with a server-made client token, so the
# client ID never needs to be public.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same app (only needed for signature verification once deployed)
PAYPAL_WEBHOOK_ID=

# --- AI ------------------------------------------------------------------
# The AI model, by either route. Set one; if both are set, Anthropic is used.
# Direct: console.anthropic.com → Settings → API keys
ANTHROPIC_API_KEY=
# Through OpenRouter: openrouter.ai → Keys (any model OpenRouter offers)
OPENROUTER_API_KEY=
# Which model, in the chosen route's naming. Defaults to Claude Sonnet 5.5:
# claude-sonnet-5-5 (Anthropic) or anthropic/claude-sonnet-5.5 (OpenRouter).
# The model needs image input, tool calls and structured output.
TEND_MODEL=

# --- Dashboard (optional) -------------------------------------------------
# AG Studio (AG Grid's embedded analytics) powers /passbook/dashboard. Without a
# key every feature works with a trial watermark. Email info@ag-grid.com for one.
AG_GRID_LICENSE_KEY=

# --- Shopping (optional) ---------------------------------------------------
# trychannel3.com: product search across retailers. Without it, a sample catalogue.
CHANNEL3_API_KEY=

# --- Database ------------------------------------------------------------
# Leave empty to use embedded Postgres (PGlite) in ./.data — zero setup.
# Set to a Postgres URL in production (e.g. Render Postgres). If it can't be
# reached, Tend falls back to the embedded database; TEND_DB_FALLBACK=0 stops that.
DATABASE_URL=
TEND_DB_FALLBACK=

# --- App -----------------------------------------------------------------
CURRENCY=USD
APP_URL=http://localhost:3000
# Lets a scheduled job call GET /api/sync with "Authorization: Bearer <secret>".
CRON_SECRET=
# Set to 0 on a public deploy to hide "Reset the demo".
TEND_ALLOW_RESET=
# Bearer token for the MCP server at /api/mcp. Without it the server is open in
# demo and sandbox mode (pretend money) and closed on live PayPal.
TEND_MCP_TOKEN=

# --- Sandbox accounts (developer.paypal.com → Testing tools → Sandbox accounts)
# One Personal sandbox account email can be reused for all of these.
# Payees Tend pays:
SANDBOX_PHARMACY_EMAIL=
SANDBOX_CARER_EMAIL=
SANDBOX_TAXI_EMAIL=
SANDBOX_SHOP_EMAIL=
# The Okafor family: siblings who receive share invoices, and Mum, who pays from her own PayPal:
SANDBOX_ADA_EMAIL=
SANDBOX_TUNDE_EMAIL=
SANDBOX_CHIOMA_EMAIL=
SANDBOX_MUM_EMAIL=
# Walter's circle: Walter pays from his own PayPal; Priya and Dolores are his second key.
SANDBOX_WALTER_EMAIL=
SANDBOX_PRIYA_EMAIL=
SANDBOX_DOLORES_EMAIL=
