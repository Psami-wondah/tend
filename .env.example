# --- PayPal (sandbox) ---------------------------------------------------
# developer.paypal.com → Apps & Credentials → Sandbox → your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same app (only needed for signature verification)
PAYPAL_WEBHOOK_ID=
# Exposed to the browser for the Checkout buttons (same value as PAYPAL_CLIENT_ID)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- AI ------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5-5
TEND_MODEL=

# --- Database ------------------------------------------------------------
# Leave empty to use embedded Postgres (PGlite) in ./.data — zero setup.
# Set to a Postgres URL in production (e.g. Render Postgres).
DATABASE_URL=

# --- App -----------------------------------------------------------------
CURRENCY=USD
APP_URL=http://localhost:3000

# --- Sandbox accounts (developer.paypal.com → Testing tools → Sandbox accounts)
# Payees Tend pays:
SANDBOX_PHARMACY_EMAIL=
SANDBOX_CARER_EMAIL=
SANDBOX_TAXI_EMAIL=
# Siblings who receive share invoices:
SANDBOX_ADA_EMAIL=
SANDBOX_TUNDE_EMAIL=
SANDBOX_CHIOMA_EMAIL=
